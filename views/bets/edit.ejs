<%# Edit Bet — Furrow theme %>

<a href="/bets/<%= bet._id %>" class="back-link">← Back to bet</a>

<%# Error Messages %>
<% if (errors.length > 0) { %>
  <div class="error-list">
    <div class="error-list-title">Please fix the following errors:</div>
    <ul>
      <% errors.forEach(err => { %>
        <li><%= err.msg %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<%# Form card %>
<div class="card">
  <div class="card-head">
    <span class="card-title">Edit bet: <%= bet.event %></span>
  </div>
  <div class="card-body">
    <form method="POST" action="/bets/<%= bet._id %>?_method=PUT">

      <%# Row 1: Date & Bet Type %>
      <div class="grid-2 mb-4">
        <div class="field">
          <label for="f-date">Date <span class="required">*</span></label>
          <input id="f-date" type="date" name="date" class="input"
            value="<%= new Date(bet.date).toISOString().split('T')[0] %>" required />
        </div>

        <div class="field">
          <label for="f-type">Bet type <span class="required">*</span></label>
          <select id="f-type" name="betType" class="input" required>
            <% ['Sports','Casino','Poker','Horse Racing','Football','Basketball','Tennis','Cricket','Boxing','UFC/MMA','eSports','Other'].forEach(type => { %>
              <option value="<%= type %>" <%= bet.betType === type ? 'selected' : '' %>><%= type %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <%# Row 2: Event & Selection %>
      <div class="grid-2 mb-4">
        <div class="field">
          <label for="f-event">Event <span class="required">*</span></label>
          <input id="f-event" type="text" name="event" class="input" value="<%= bet.event %>" required />
        </div>

        <div class="field">
          <label for="f-selection">Your selection</label>
          <input id="f-selection" type="text" name="selection" class="input" value="<%= bet.selection || '' %>" />
        </div>
      </div>

      <%# Row 3: Platform, Odds, Stake %>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:var(--space-md);margin-bottom:var(--space-md)">
        <div class="field">
          <label for="f-platform">Platform <span class="required">*</span></label>
          <select id="f-platform" name="platform" class="input" required>
            <% ['Betway','Bet365','Dream11','MPL','My11Circle','FanCode','Parimatch','RummyCircle','Other'].forEach(p => { %>
              <option value="<%= p %>" <%= bet.platform === p ? 'selected' : '' %>><%= p %></option>
            <% }) %>
          </select>
        </div>

        <div class="field">
          <label for="f-odds">Odds <span class="required">*</span></label>
          <input id="f-odds" type="number" name="odds" class="input input--num"
            value="<%= bet.odds %>" step="0.01" min="1" required />
        </div>

        <div class="field">
          <label for="f-stake">Stake (₹) <span class="required">*</span></label>
          <input id="f-stake" type="number" name="stake" class="input input--num"
            value="<%= bet.stake %>" step="0.01" min="0.01" required />
        </div>
      </div>

      <%# Result selection %>
      <div class="field mb-4">
        <label>Result <span class="required">*</span></label>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(100px,1fr));gap:8px">
          <% [
            { value: 'Pending', icon: '⏳' },
            { value: 'Win', icon: '✅' },
            { value: 'Loss', icon: '❌' },
            { value: 'Half Win', icon: '🟩' },
            { value: 'Half Loss', icon: '🟥' },
            { value: 'Void', icon: '⭕' },
          ].forEach(r => { %>
            <label class="result-option">
              <input type="radio" name="result" value="<%= r.value %>" <%= bet.result === r.value ? 'checked' : '' %> />
              <div class="result-option-card">
                <div class="result-option-icon"><%= r.icon %></div>
                <div class="result-option-label"><%= r.value %></div>
              </div>
            </label>
          <% }) %>
        </div>
      </div>

      <hr class="form-rule" />

      <%# Notes & Tags %>
      <div class="grid-2 mb-4">
        <div class="field">
          <label for="f-notes">Notes</label>
          <textarea id="f-notes" name="notes" class="input" rows="3"><%= bet.notes || '' %></textarea>
        </div>
        <div class="field">
          <label for="f-tags">Tags (comma-separated)</label>
          <input id="f-tags" type="text" name="tags" class="input"
            value="<%= Array.isArray(bet.tags) ? bet.tags.join(', ') : '' %>" />
        </div>
      </div>

      <%# Action Buttons %>
      <div style="display:flex;gap:var(--space-sm);padding-top:var(--space-md);border-top:var(--rule-hair)">
        <button type="submit" class="btn btn--primary" style="flex:1">Update bet</button>
        <a href="/bets/<%= bet._id %>" class="btn">Cancel</a>
        <form method="POST" action="/bets/<%= bet._id %>?_method=DELETE" style="display:inline"
          onsubmit="return confirm('Are you sure you want to delete this bet?')">
          <button type="submit" class="btn btn--danger">Delete</button>
        </form>
      </div>
    </form>
  </div>
</div>
