<%# All Bets — Furrow theme %>

<%# ── Toolbar ── %>
<div class="toolbar mb-6">
  <div class="toolbar-left">
    <span class="section-title">All bets</span>
    <span class="record-count"><%= totalBets %> records</span>
  </div>
  <div class="toolbar-right">
    <a href="/bets/export/csv" class="btn btn--sm">CSV</a>
    <a href="/bets/export/pdf" class="btn btn--sm">PDF</a>
    <a href="/bets/new" class="btn btn--primary btn--sm">+ Add bet</a>
  </div>
</div>

<%# ── Filters ── %>
<div class="card mb-6">
  <div class="card-body">
    <form method="GET" action="/bets">
      <div class="filter-bar">
        <div class="field">
          <label for="f-search">Search</label>
          <input id="f-search" type="text" name="search" class="input" placeholder="Event, selection…" value="<%= filters.search || '' %>" />
        </div>
        <div class="field">
          <label for="f-start">From</label>
          <input id="f-start" type="date" name="startDate" class="input" value="<%= filters.startDate || '' %>" />
        </div>
        <div class="field">
          <label for="f-end">To</label>
          <input id="f-end" type="date" name="endDate" class="input" value="<%= filters.endDate || '' %>" />
        </div>
        <div class="field">
          <label for="f-platform">Platform</label>
          <select id="f-platform" name="platform" class="input">
            <option value="all">All platforms</option>
            <% platforms.forEach(p => { %>
              <option value="<%= p %>" <%= filters.platform === p ? 'selected' : '' %>><%= p %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label for="f-result">Result</label>
          <select id="f-result" name="result" class="input">
            <option value="all">All results</option>
            <option value="Win"       <%= filters.result === 'Win'       ? 'selected' : '' %>>Win</option>
            <option value="Loss"      <%= filters.result === 'Loss'      ? 'selected' : '' %>>Loss</option>
            <option value="Pending"   <%= filters.result === 'Pending'   ? 'selected' : '' %>>Pending</option>
            <option value="Void"      <%= filters.result === 'Void'      ? 'selected' : '' %>>Void</option>
            <option value="Half Win"  <%= filters.result === 'Half Win'  ? 'selected' : '' %>>Half win</option>
            <option value="Half Loss" <%= filters.result === 'Half Loss' ? 'selected' : '' %>>Half loss</option>
          </select>
        </div>
        <div class="field" style="flex-direction:row;align-items:flex-end;gap:8px">
          <button type="submit" class="btn btn--primary">Filter</button>
          <a href="/bets" class="btn">Clear</a>
        </div>
      </div>
    </form>
  </div>
</div>

<%# ── Mini stats bar ── %>
<div class="grid-4 mb-6">
  <div class="stat-card" style="text-align:center">
    <div class="stat-card-label">Bets</div>
    <div class="stat-card-value" style="font-size:22px"><%= stats.totalBets %></div>
  </div>
  <div class="stat-card" style="text-align:center">
    <div class="stat-card-label">Win rate</div>
    <div class="stat-card-value <%= parseFloat(stats.winRate) >= 50 ? 'stat-card-value--green' : 'stat-card-value--red' %>" style="font-size:22px">
      <span class="td-num"><%= stats.winRate %>%</span>
    </div>
  </div>
  <div class="stat-card" style="text-align:center">
    <div class="stat-card-label">P&amp;L</div>
    <div class="stat-card-value <%= stats.totalProfitLoss >= 0 ? 'stat-card-value--green' : 'stat-card-value--red' %>" style="font-size:22px">
      <span class="td-num"><%= stats.totalProfitLoss >= 0 ? '+' : '' %>₹<%= stats.totalProfitLoss.toFixed(2) %></span>
    </div>
  </div>
  <div class="stat-card" style="text-align:center">
    <div class="stat-card-label">ROI</div>
    <div class="stat-card-value <%= parseFloat(stats.roi) >= 0 ? 'stat-card-value--green' : 'stat-card-value--red' %>" style="font-size:22px">
      <span class="td-num"><%= stats.roi %>%</span>
    </div>
  </div>
</div>

<%# ── Bets table ── %>
<div class="card">
  <% if (bets.length === 0) { %>
    <div class="empty-state">
      <div class="empty-state-icon">📋</div>
      <div class="empty-state-title">No bets found</div>
      <p>Try adjusting your filters or <a href="/bets/new">add a new bet</a></p>
    </div>
  <% } else { %>
    <div class="ruled-table-wrap">
      <table class="ruled-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Event</th>
            <th class="hidden-sm">Type</th>
            <th class="hidden-md">Platform</th>
            <th class="text-right hidden-lg">Odds</th>
            <th class="text-right">Stake</th>
            <th class="text-center">Result</th>
            <th class="text-right">P&amp;L</th>
            <th class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% bets.forEach(bet => { %>
            <tr>
              <td class="td-num" style="white-space:nowrap;font-size:12px;color:var(--color-muted)">
                <%= moment(bet.date).format('DD MMM YY') %>
              </td>
              <td>
                <div class="td-event">
                  <%= bet.event.length > 36 ? bet.event.substring(0, 36) + '…' : bet.event %>
                </div>
                <% if (bet.selection) { %>
                  <div class="td-sub"><%= bet.selection %></div>
                <% } %>
              </td>
              <td class="hidden-sm"><span class="type-chip"><%= bet.betType %></span></td>
              <td class="hidden-md" style="font-size:12px;color:var(--color-muted)"><%= bet.platform %></td>
              <td class="text-right td-num hidden-lg"><%= bet.odds.toFixed(2) %></td>
              <td class="text-right td-num">₹<%= bet.stake.toFixed(2) %></td>
              <td class="text-center">
                <span class="result-chip result-chip--<%= bet.result.toLowerCase().replace(/ /g,'') %>">
                  <%= bet.result %>
                </span>
              </td>
              <td class="text-right td-num <%= bet.profitLoss >= 0 ? 'td-num--green' : 'td-num--red' %>">
                <%= bet.profitLoss >= 0 ? '+' : '' %>₹<%= bet.profitLoss.toFixed(2) %>
              </td>
              <td class="text-center">
                <div class="action-icons">
                  <a href="/bets/<%= bet._id %>" class="action-btn" title="View">
                    <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor"><path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/><path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/></svg>
                  </a>
                  <a href="/bets/<%= bet._id %>/edit" class="action-btn" title="Edit">
                    <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zm-2.207 2.207L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/></svg>
                  </a>
                  <form method="POST" action="/bets/<%= bet._id %>?_method=DELETE" onsubmit="return confirm('Delete this bet?')">
                    <button type="submit" class="action-btn action-btn--danger" title="Delete">
                      <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <%# Pagination %>
    <% if (totalPages > 1) { %>
      <div class="pagination">
        <p class="pagination-info">Page <%= currentPage %> of <%= totalPages %> — <%= totalBets %> bets</p>
        <div class="pagination-links">
          <% if (currentPage > 1) { %>
            <a href="?page=<%= currentPage - 1 %>&search=<%= filters.search || '' %>&startDate=<%= filters.startDate || '' %>&endDate=<%= filters.endDate || '' %>&platform=<%= filters.platform || 'all' %>&result=<%= filters.result || 'all' %>"
               class="pagination-link">←</a>
          <% } %>
          <% for (let p = Math.max(1, currentPage - 2); p <= Math.min(totalPages, currentPage + 2); p++) { %>
            <a href="?page=<%= p %>&search=<%= filters.search || '' %>&startDate=<%= filters.startDate || '' %>&endDate=<%= filters.endDate || '' %>&platform=<%= filters.platform || 'all' %>&result=<%= filters.result || 'all' %>"
               class="pagination-link <%= p === currentPage ? 'pagination-link--active' : '' %>"><%= p %></a>
          <% } %>
          <% if (currentPage < totalPages) { %>
            <a href="?page=<%= currentPage + 1 %>&search=<%= filters.search || '' %>&startDate=<%= filters.startDate || '' %>&endDate=<%= filters.endDate || '' %>&platform=<%= filters.platform || 'all' %>&result=<%= filters.result || 'all' %>"
               class="pagination-link">→</a>
          <% } %>
        </div>
      </div>
    <% } %>
  <% } %>
</div>

<style>
.hidden-sm { display: none; }
.hidden-md { display: none; }
.hidden-lg { display: none; }
@media (min-width: 540px)  { .hidden-sm { display: table-cell; } }
@media (min-width: 768px)  { .hidden-md { display: table-cell; } }
@media (min-width: 1024px) { .hidden-lg { display: table-cell; } }
</style>
