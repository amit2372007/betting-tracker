<!-- All Bets View -->

<!-- Toolbar -->
<div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center justify-between mb-6">
  <div class="flex items-center gap-2">
    <h2 class="text-lg font-semibold text-white">All Bets</h2>
    <span class="bg-blue-600/20 text-blue-400 text-xs px-2 py-1 rounded-full font-medium"><%= totalBets %> records</span>
  </div>
  <div class="flex gap-2">
    <a href="/bets/export/csv" class="flex items-center gap-1 bg-gray-800 hover:bg-gray-700 text-gray-300 px-3 py-2 rounded-lg text-xs font-medium transition-colors">
      📄 CSV
    </a>
    <a href="/bets/export/pdf" class="flex items-center gap-1 bg-gray-800 hover:bg-gray-700 text-gray-300 px-3 py-2 rounded-lg text-xs font-medium transition-colors">
      📑 PDF
    </a>
    <a href="/bets/new" class="flex items-center gap-1 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors shadow-lg shadow-blue-600/30">
      ➕ Add Bet
    </a>
  </div>
</div>

<!-- Filters -->
<div class="bg-gray-900 border border-gray-800 rounded-2xl p-5 mb-6">
  <form method="GET" action="/bets" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
    <div class="lg:col-span-1">
      <input type="text" name="search" placeholder="🔍 Search..." value="<%= filters.search || '' %>"
        class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500 transition-colors placeholder-gray-500" />
    </div>
    <div>
      <input type="date" name="startDate" value="<%= filters.startDate || '' %>"
        class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500 transition-colors" />
    </div>
    <div>
      <input type="date" name="endDate" value="<%= filters.endDate || '' %>"
        class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500 transition-colors" />
    </div>
    <div>
      <select name="platform" class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500 transition-colors">
        <option value="all">All Platforms</option>
        <% platforms.forEach(p => { %>
          <option value="<%= p %>" <%= filters.platform === p ? 'selected' : '' %>><%= p %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <select name="result" class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500 transition-colors">
        <option value="all">All Results</option>
        <option value="Win" <%= filters.result === 'Win' ? 'selected' : '' %>>Win</option>
        <option value="Loss" <%= filters.result === 'Loss' ? 'selected' : '' %>>Loss</option>
        <option value="Pending" <%= filters.result === 'Pending' ? 'selected' : '' %>>Pending</option>
        <option value="Void" <%= filters.result === 'Void' ? 'selected' : '' %>>Void</option>
        <option value="Half Win" <%= filters.result === 'Half Win' ? 'selected' : '' %>>Half Win</option>
        <option value="Half Loss" <%= filters.result === 'Half Loss' ? 'selected' : '' %>>Half Loss</option>
      </select>
    </div>
    <div class="flex gap-2">
      <button type="submit" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white px-3 py-2 rounded-lg text-sm font-medium transition-colors">Filter</button>
      <a href="/bets" class="bg-gray-700 hover:bg-gray-600 text-white px-3 py-2 rounded-lg text-sm font-medium transition-colors">✕</a>
    </div>
  </form>
</div>

<!-- Mini Stats Bar -->
<div class="grid grid-cols-4 gap-3 mb-6">
  <div class="bg-blue-950/30 border border-blue-800/30 rounded-xl p-3 text-center">
    <div class="text-blue-400 font-bold"><%= stats.totalBets %></div>
    <div class="text-xs text-gray-500">Bets</div>
  </div>
  <div class="bg-green-950/30 border border-green-800/30 rounded-xl p-3 text-center">
    <div class="text-green-400 font-bold"><%= stats.winRate %>%</div>
    <div class="text-xs text-gray-500">Win Rate</div>
  </div>
  <div class="<%= stats.totalProfitLoss >= 0 ? 'bg-green-950/30 border-green-800/30' : 'bg-red-950/30 border-red-800/30' %> border rounded-xl p-3 text-center">
    <div class="<%= stats.totalProfitLoss >= 0 ? 'text-green-400' : 'text-red-400' %> font-bold">
      <%= stats.totalProfitLoss >= 0 ? '+' : '' %>₹<%= stats.totalProfitLoss.toFixed(2) %>
    </div>
    <div class="text-xs text-gray-500">P&L</div>
  </div>
  <div class="<%= parseFloat(stats.roi) >= 0 ? 'bg-green-950/30 border-green-800/30' : 'bg-red-950/30 border-red-800/30' %> border rounded-xl p-3 text-center">
    <div class="<%= parseFloat(stats.roi) >= 0 ? 'text-green-400' : 'text-red-400' %> font-bold"><%= stats.roi %>%</div>
    <div class="text-xs text-gray-500">ROI</div>
  </div>
</div>

<!-- Bets Table -->
<div class="bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden">
  <% if (bets.length === 0) { %>
    <div class="text-center py-16 text-gray-500">
      <div class="text-5xl mb-4">🎲</div>
      <p class="text-lg font-medium text-gray-400">No bets found</p>
      <p class="text-sm mt-1">Try adjusting your filters or <a href="/bets/new" class="text-blue-400 hover:text-blue-300">add a new bet</a></p>
    </div>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-gray-800/50">
          <tr class="text-gray-400 text-left">
            <th class="px-4 py-4 font-medium">Date</th>
            <th class="px-4 py-4 font-medium">Event</th>
            <th class="px-4 py-4 font-medium hidden sm:table-cell">Type</th>
            <th class="px-4 py-4 font-medium hidden md:table-cell">Platform</th>
            <th class="px-4 py-4 font-medium text-right hidden lg:table-cell">Odds</th>
            <th class="px-4 py-4 font-medium text-right">Stake</th>
            <th class="px-4 py-4 font-medium text-center">Result</th>
            <th class="px-4 py-4 font-medium text-right">P&L</th>
            <th class="px-4 py-4 font-medium text-center">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-800">
          <% bets.forEach(bet => { %>
            <tr class="hover:bg-gray-800/40 transition-colors group">
              <td class="px-4 py-3.5 text-gray-400 text-xs whitespace-nowrap">
                <%= moment(bet.date).format('DD MMM YY') %>
              </td>
              <td class="px-4 py-3.5">
                <div class="font-medium text-white">
                  <%= bet.event.length > 35 ? bet.event.substring(0, 35) + '...' : bet.event %>
                </div>
                <% if (bet.selection) { %>
                  <div class="text-xs text-gray-500 mt-0.5"><%= bet.selection %></div>
                <% } %>
              </td>
              <td class="px-4 py-3.5 hidden sm:table-cell">
                <span class="bg-gray-800 text-gray-300 px-2 py-1 rounded-md text-xs"><%= bet.betType %></span>
              </td>
              <td class="px-4 py-3.5 text-gray-400 text-xs hidden md:table-cell"><%= bet.platform %></td>
              <td class="px-4 py-3.5 text-right text-gray-300 hidden lg:table-cell"><%= bet.odds.toFixed(2) %></td>
              <td class="px-4 py-3.5 text-right text-gray-300 font-medium">₹<%= bet.stake.toFixed(2) %></td>
              <td class="px-4 py-3.5 text-center">
                <span class="px-2 py-1 rounded-full text-xs font-medium whitespace-nowrap
                  <%= bet.result === 'Win' ? 'bg-green-900/60 text-green-400' :
                     bet.result === 'Loss' ? 'bg-red-900/60 text-red-400' :
                     bet.result === 'Pending' ? 'bg-yellow-900/60 text-yellow-400' :
                     bet.result === 'Half Win' ? 'bg-emerald-900/60 text-emerald-400' :
                     bet.result === 'Half Loss' ? 'bg-orange-900/60 text-orange-400' :
                     'bg-gray-800 text-gray-400' %>">
                  <%= bet.result %>
                </span>
              </td>
              <td class="px-4 py-3.5 text-right font-semibold whitespace-nowrap
                <%= bet.profitLoss >= 0 ? 'text-green-400' : 'text-red-400' %>">
                <%= bet.profitLoss >= 0 ? '+' : '' %>₹<%= bet.profitLoss.toFixed(2) %>
              </td>
              <td class="px-4 py-3.5 text-center">
                <div class="flex items-center justify-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                  <a href="/bets/<%= bet._id %>" class="p-1.5 text-gray-400 hover:text-blue-400 hover:bg-blue-900/30 rounded-lg transition-colors" title="View">
                    👁
                  </a>
                  <a href="/bets/<%= bet._id %>/edit" class="p-1.5 text-gray-400 hover:text-yellow-400 hover:bg-yellow-900/30 rounded-lg transition-colors" title="Edit">
                    ✏️
                  </a>
                  <form method="POST" action="/bets/<%= bet._id %>?_method=DELETE" onsubmit="return confirm('Delete this bet?')">
                    <button type="submit" class="p-1.5 text-gray-400 hover:text-red-400 hover:bg-red-900/30 rounded-lg transition-colors" title="Delete">
                      🗑
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div class="flex items-center justify-between px-4 py-4 border-t border-gray-800">
        <p class="text-xs text-gray-400">
          Page <%= currentPage %> of <%= totalPages %> • <%= totalBets %> total bets
        </p>
        <div class="flex gap-1">
          <% if (currentPage > 1) { %>
            <a href="?page=<%= currentPage - 1 %>&search=<%= filters.search || '' %>&startDate=<%= filters.startDate || '' %>&endDate=<%= filters.endDate || '' %>&platform=<%= filters.platform || 'all' %>&result=<%= filters.result || 'all' %>"
              class="px-3 py-1.5 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded-lg text-xs transition-colors">← Prev</a>
          <% } %>

          <% for (let p = Math.max(1, currentPage - 2); p <= Math.min(totalPages, currentPage + 2); p++) { %>
            <a href="?page=<%= p %>&search=<%= filters.search || '' %>&startDate=<%= filters.startDate || '' %>&endDate=<%= filters.endDate || '' %>&platform=<%= filters.platform || 'all' %>&result=<%= filters.result || 'all' %>"
              class="px-3 py-1.5 <%= p === currentPage ? 'bg-blue-600 text-white' : 'bg-gray-800 hover:bg-gray-700 text-gray-300' %> rounded-lg text-xs transition-colors">
              <%= p %>
            </a>
          <% } %>

          <% if (currentPage < totalPages) { %>
            <a href="?page=<%= currentPage + 1 %>&search=<%= filters.search || '' %>&startDate=<%= filters.startDate || '' %>&endDate=<%= filters.endDate || '' %>&platform=<%= filters.platform || 'all' %>&result=<%= filters.result || 'all' %>"
              class="px-3 py-1.5 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded-lg text-xs transition-colors">Next →</a>
          <% } %>
        </div>
      </div>
    <% } %>
  <% } %>
</div>
