<%# Add New Bet — Furrow theme %>

<a href="/bets" class="back-link">← All bets</a>

<%# Error Messages %>
<% if (errors.length > 0) { %>
  <div class="error-list">
    <div class="error-list-title">Please fix the following errors:</div>
    <ul>
      <% errors.forEach(err => { %>
        <li><%= err.msg %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<%# Form card %>
<div class="card">
  <div class="card-head">
    <span class="card-title">Record new bet</span>
  </div>
  <div class="card-body">
    <form method="POST" action="/bets">

      <%# Row 1: Date & Bet Type %>
      <div class="grid-2 mb-4">
        <div class="field">
          <label for="f-date">Date <span class="required">*</span></label>
          <input id="f-date" type="date" name="date" class="input"
            value="<%= bet.date ? new Date(bet.date).toISOString().split('T')[0] : new Date().toISOString().split('T')[0] %>" required />
        </div>

        <div class="field">
          <label for="f-type">Bet type <span class="required">*</span></label>
          <select id="f-type" name="betType" class="input" required>
            <option value="">Select bet type...</option>
            <% ['Sports','Casino','Poker','Horse Racing','Football','Basketball','Tennis','Cricket','Boxing','UFC/MMA','eSports','Other'].forEach(type => { %>
              <option value="<%= type %>" <%= bet.betType === type ? 'selected' : '' %>><%= type %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <%# Row 2: Event & Selection %>
      <div class="grid-2 mb-4">
        <div class="field">
          <label for="f-event">Event <span class="required">*</span></label>
          <input id="f-event" type="text" name="event" class="input" placeholder="e.g., CSK vs MI, Euro 2024 Final"
            value="<%= bet.event || '' %>" required />
        </div>

        <div class="field">
          <label for="f-selection">Your selection</label>
          <input id="f-selection" type="text" name="selection" class="input" placeholder="e.g., CSK to win, Over 6.5 goals"
            value="<%= bet.selection || '' %>" />
        </div>
      </div>

      <%# Row 3: Platform, Odds, Stake %>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:var(--space-md);margin-bottom:var(--space-md)">
        <div class="field">
          <label for="f-platform">Platform <span class="required">*</span></label>
          <select id="f-platform" name="platform" class="input" required>
            <option value="">Select platform...</option>
            <% ['Betway','Bet365','Dream11','MPL','My11Circle','FanCode','Parimatch','RummyCircle','Other'].forEach(p => { %>
              <option value="<%= p %>" <%= bet.platform === p ? 'selected' : '' %>><%= p %></option>
            <% }) %>
          </select>
        </div>

        <div class="field">
          <label for="f-odds">Odds <span class="required">*</span></label>
          <input id="f-odds" type="number" name="odds" class="input input--num" placeholder="e.g., 1.85"
            value="<%= bet.odds || '' %>" step="0.01" min="1" required />
        </div>

        <div class="field">
          <label for="f-stake">Stake (₹) <span class="required">*</span></label>
          <input id="f-stake" type="number" name="stake" class="input input--num" placeholder="e.g., 500"
            value="<%= bet.stake || '' %>" step="0.01" min="0.01" required />
        </div>
      </div>

      <%# Result selection %>
      <div class="field mb-4">
        <label>Result <span class="required">*</span></label>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(100px,1fr));gap:8px">
          <% [
            { value: 'Pending', icon: '⏳' },
            { value: 'Win', icon: '✅' },
            { value: 'Loss', icon: '❌' },
            { value: 'Half Win', icon: '🟩' },
            { value: 'Half Loss', icon: '🟥' },
            { value: 'Void', icon: '⭕' },
          ].forEach(r => { %>
            <label class="result-option">
              <input type="radio" name="result" value="<%= r.value %>"
                <%= bet.result === r.value || (!bet.result && r.value === 'Pending') ? 'checked' : '' %> />
              <div class="result-option-card">
                <div class="result-option-icon"><%= r.icon %></div>
                <div class="result-option-label"><%= r.value %></div>
              </div>
            </label>
          <% }) %>
        </div>
      </div>

      <%# P/L Preview %>
      <div id="plPreview" class="pl-preview mb-4" style="display:none">
        <div class="pl-preview-label">Estimated P&L</div>
        <div id="plAmount" class="pl-preview-value">₹0.00</div>
      </div>

      <hr class="form-rule" />

      <%# Notes & Tags %>
      <div class="grid-2 mb-4">
        <div class="field">
          <label for="f-notes">Notes</label>
          <textarea id="f-notes" name="notes" class="input" rows="3"
            placeholder="Add any notes about this bet..."><%= bet.notes || '' %></textarea>
        </div>
        <div class="field">
          <label for="f-tags">Tags (comma-separated)</label>
          <input id="f-tags" type="text" name="tags" class="input"
            placeholder="e.g., sure-shot, tip, season-bet"
            value="<%= Array.isArray(bet.tags) ? bet.tags.join(', ') : (bet.tags || '') %>" />
        </div>
      </div>

      <%# Submit Buttons %>
      <div style="display:flex;gap:var(--space-sm);padding-top:var(--space-md);border-top:var(--rule-hair)">
        <button type="submit" class="btn btn--primary" style="flex:1">Record bet</button>
        <a href="/bets" class="btn">Cancel</a>
      </div>
    </form>
  </div>
</div>

<script>
  // Live P&L calculator
  const stakeInput = document.getElementById('f-stake');
  const oddsInput = document.getElementById('f-odds');
  const resultRadios = document.querySelectorAll('input[name="result"]');
  const plPreview = document.getElementById('plPreview');
  const plAmount = document.getElementById('plAmount');

  function updatePL() {
    const stake = parseFloat(stakeInput.value) || 0;
    const odds = parseFloat(oddsInput.value) || 0;
    const result = document.querySelector('input[name="result"]:checked')?.value;

    if (stake > 0 && odds > 0 && result) {
      let pl = 0;
      if (result === 'Win') pl = stake * (odds - 1);
      else if (result === 'Loss') pl = -stake;
      else if (result === 'Half Win') pl = (stake * (odds - 1)) / 2;
      else if (result === 'Half Loss') pl = -stake / 2;

      plPreview.style.display = 'block';
      plAmount.textContent = (pl >= 0 ? '+' : '') + '₹' + pl.toFixed(2);
      plAmount.className = 'pl-preview-value' + (pl >= 0 ? '' : ' pl-preview-value--negative');
    } else {
      plPreview.style.display = 'none';
    }
  }

  stakeInput.addEventListener('input', updatePL);
  oddsInput.addEventListener('input', updatePL);
  resultRadios.forEach(r => r.addEventListener('change', updatePL));
</script>
