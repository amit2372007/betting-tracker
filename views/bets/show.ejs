<%# Bet Detail — Furrow theme %>

<a href="/bets" class="back-link">← All bets</a>

<%# Main Card %>
<div class="card" style="max-width:900px">

  <%# P&L Banner %>
  <div class="detail-banner <%= bet.result === 'Win' ? 'detail-banner--win' : bet.result === 'Loss' ? 'detail-banner--loss' : '' %>">
    <div>
      <div class="detail-result-label">Profit / Loss</div>
      <div class="detail-pl <%= bet.profitLoss >= 0 ? 'detail-pl--green' : 'detail-pl--red' %>">
        <%= bet.profitLoss >= 0 ? '+' : '' %>₹<%= bet.profitLoss.toFixed(2) %>
      </div>
    </div>
    <div>
      <span class="result-chip result-chip--<%= bet.result.toLowerCase().replace(/ /g,'') %>" style="font-size:14px;padding:6px 14px">
        <%= bet.result %>
      </span>
      <div class="detail-result-label" style="margin-top:8px;text-align:right">
        <%= moment(bet.date).format('DD MMMM YYYY') %>
      </div>
    </div>
  </div>

  <%# Details Grid %>
  <div class="detail-grid">
    <div>
      <div class="detail-field-label">Event</div>
      <div class="detail-field-value"><%= bet.event %></div>
    </div>

    <% if (bet.selection) { %>
    <div>
      <div class="detail-field-label">Selection</div>
      <div class="detail-field-value"><%= bet.selection %></div>
    </div>
    <% } %>

    <div>
      <div class="detail-field-label">Bet type</div>
      <div class="detail-field-value"><%= bet.betType %></div>
    </div>

    <div>
      <div class="detail-field-label">Platform</div>
      <div class="detail-field-value"><%= bet.platform %></div>
    </div>

    <div>
      <div class="detail-field-label">Stake</div>
      <div class="detail-field-value td-num">₹<%= bet.stake.toFixed(2) %></div>
    </div>

    <div>
      <div class="detail-field-label">Odds</div>
      <div class="detail-field-value td-num"><%= bet.odds.toFixed(2) %></div>
    </div>

    <div>
      <div class="detail-field-label">Potential return</div>
      <div class="detail-field-value td-num">₹<%= (bet.stake * bet.odds).toFixed(2) %></div>
    </div>

    <div>
      <div class="detail-field-label">ROI</div>
      <div class="detail-field-value td-num <%= bet.profitLoss >= 0 ? 'td-num--green' : 'td-num--red' %>">
        <%= ((bet.profitLoss / bet.stake) * 100).toFixed(1) %>%
      </div>
    </div>
  </div>

  <%# Notes %>
  <% if (bet.notes) { %>
    <div class="notes-block">
      <div style="font-size:11.5px;font-weight:500;color:var(--color-muted);margin-bottom:6px">Notes</div>
      <%= bet.notes %>
    </div>
  <% } %>

  <%# Tags %>
  <% if (bet.tags && bet.tags.length > 0) { %>
    <div style="margin:0 var(--space-lg) var(--space-lg)">
      <div style="font-size:11.5px;font-weight:500;color:var(--color-muted);margin-bottom:8px">Tags</div>
      <div style="display:flex;gap:6px;flex-wrap:wrap">
        <% bet.tags.forEach(tag => { %>
          <span class="tag">#<%= tag %></span>
        <% }) %>
      </div>
    </div>
  <% } %>

  <%# Footer with timestamps and actions %>
  <div style="padding:var(--space-md) var(--space-lg);border-top:var(--rule-hair);display:flex;align-items:center;justify-content:space-between;gap:var(--space-md);flex-wrap:wrap">
    <div style="font-size:11px;color:var(--color-muted)">
      Added: <%= moment(bet.createdAt).format('DD MMM YYYY, HH:mm') %>
      <% if (bet.updatedAt && bet.updatedAt.toString() !== bet.createdAt.toString()) { %>
        • Updated: <%= moment(bet.updatedAt).format('DD MMM YYYY, HH:mm') %>
      <% } %>
    </div>
    <div style="display:flex;gap:var(--space-sm)">
      <a href="/bets/<%= bet._id %>/edit" class="btn btn--sm">Edit</a>
      <form method="POST" action="/bets/<%= bet._id %>?_method=DELETE" style="display:inline"
        onsubmit="return confirm('Delete this bet? This action cannot be undone.')">
        <button type="submit" class="btn btn--danger btn--sm">Delete</button>
      </form>
    </div>
  </div>
</div>
