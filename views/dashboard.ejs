<%# Dashboard — Furrow theme %>

<%# ── Stats grid ── %>
<div class="grid-4 mb-8">

  <div class="stat-card">
    <div class="stat-card-label">Total bets</div>
    <div class="stat-card-value"><%= stats.totalBets %></div>
    <div class="stat-card-meta">
      <span class="stat-chip stat-chip--green"><%= stats.wins %> W</span>
      <span class="stat-chip stat-chip--red"><%= stats.losses %> L</span>
      <span class="stat-chip stat-chip--yellow"><%= stats.pending %> pending</span>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-card-label">Win rate</div>
    <div class="stat-card-value <%= parseFloat(stats.winRate) >= 50 ? 'stat-card-value--green' : 'stat-card-value--red' %>">
      <span class="td-num"><%= stats.winRate %>%</span>
    </div>
    <div class="progress-track">
      <div class="progress-fill <%= parseFloat(stats.winRate) >= 50 ? 'progress-fill--green' : 'progress-fill--red' %>"
           style="width: <%= Math.min(stats.winRate, 100) %>%"></div>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-card-label"><%= stats.totalProfitLoss >= 0 ? 'Total profit' : 'Total loss' %></div>
    <div class="stat-card-value <%= stats.totalProfitLoss >= 0 ? 'stat-card-value--green' : 'stat-card-value--red' %>">
      <span class="td-num"><%= stats.totalProfitLoss >= 0 ? '+' : '' %>₹<%= Math.abs(stats.totalProfitLoss).toFixed(2) %></span>
    </div>
    <div class="stat-card-sub">Staked ₹<%= stats.totalStaked.toFixed(2) %></div>
  </div>

  <div class="stat-card">
    <div class="stat-card-label">ROI</div>
    <div class="stat-card-value <%= parseFloat(stats.roi) >= 0 ? 'stat-card-value--green' : 'stat-card-value--red' %>">
      <span class="td-num"><%= stats.roi %>%</span>
    </div>
    <div class="stat-card-sub">Avg stake ₹<%= parseFloat(stats.averageStake).toFixed(2) %></div>
  </div>
</div>

<%# ── Secondary stats ── %>
<div class="grid-4 mb-8">
  <div class="stat-card">
    <div class="stat-card-label">Biggest win</div>
    <div class="stat-card-value stat-card-value--green" style="font-size:20px">
      <span class="td-num">₹<%= stats.biggestWin.toFixed(2) %></span>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-card-label">Biggest loss</div>
    <div class="stat-card-value stat-card-value--red" style="font-size:20px">
      <span class="td-num">₹<%= Math.abs(stats.biggestLoss).toFixed(2) %></span>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-card-label">Total wins</div>
    <div class="stat-card-value" style="font-size:20px"><%= stats.wins %></div>
  </div>
  <div class="stat-card">
    <div class="stat-card-label">Total staked</div>
    <div class="stat-card-value" style="font-size:20px">
      <span class="td-num">₹<%= stats.totalStaked.toFixed(2) %></span>
    </div>
  </div>
</div>

<%# ── Filters ── %>
<div class="card mb-8">
  <div class="card-head">
    <span class="card-title">Filter dashboard</span>
  </div>
  <div class="card-body">
    <form method="GET" action="/" id="filterForm">
      <div class="filter-bar">
        <div class="field">
          <label for="f-start">From date</label>
          <input id="f-start" type="date" name="startDate" class="input"
            value="<%= filters && filters.startDate ? filters.startDate : '' %>" />
        </div>
        <div class="field">
          <label for="f-end">To date</label>
          <input id="f-end" type="date" name="endDate" class="input"
            value="<%= filters && filters.endDate ? filters.endDate : '' %>" />
        </div>
        <div class="field">
          <label for="f-platform">Platform</label>
          <select id="f-platform" name="platform" class="input">
            <option value="all">All platforms</option>
            <% platforms.forEach(p => { %>
              <option value="<%= p %>" <%= filters && filters.platform === p ? 'selected' : '' %>><%= p %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label for="f-type">Bet type</label>
          <select id="f-type" name="betType" class="input">
            <option value="all">All types</option>
            <% betTypes.forEach(t => { %>
              <option value="<%= t %>" <%= filters && filters.betType === t ? 'selected' : '' %>><%= t %></option>
            <% }) %>
          </select>
        </div>
        <div class="field" style="justify-content:flex-end;flex-direction:row;gap:8px;align-items:flex-end">
          <button type="submit" class="btn btn--primary">Apply</button>
          <a href="/" class="btn">Reset</a>
        </div>
      </div>
    </form>
  </div>
</div>

<%# ── Charts ── %>
<div class="grid-charts mb-8">

  <div class="card col-span-2">
    <div class="card-head">
      <span class="card-title">Profit / loss over time — last 12 months</span>
      <div style="display:flex;gap:12px;font-size:12px;color:var(--color-muted)">
        <span style="display:flex;align-items:center;gap:5px">
          <span style="width:10px;height:10px;border-radius:50%;background:var(--color-accent);display:inline-block"></span>
          Monthly P&amp;L
        </span>
        <span style="display:flex;align-items:center;gap:5px">
          <span style="width:10px;height:10px;border-radius:50%;background:var(--color-muted);display:inline-block"></span>
          Cumulative
        </span>
      </div>
    </div>
    <div class="card-body">
      <div class="chart-wrap h-64"><canvas id="plLineChart"></canvas></div>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><span class="card-title">Bets by type</span></div>
    <div class="card-body">
      <div class="chart-wrap h-56"><canvas id="betTypePieChart"></canvas></div>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><span class="card-title">Result distribution</span></div>
    <div class="card-body">
      <div class="chart-wrap h-56"><canvas id="resultDonutChart"></canvas></div>
    </div>
  </div>

  <div class="card col-span-2">
    <div class="card-head"><span class="card-title">Activity by platform</span></div>
    <div class="card-body">
      <div class="chart-wrap h-56"><canvas id="platformBarChart"></canvas></div>
    </div>
  </div>
</div>

<%# ── Weekly progress ── %>
<div class="card mb-8">
  <div class="card-head"><span class="card-title">Weekly progress — last 12 weeks</span></div>
  <div class="card-body">
    <div class="chart-wrap h-64"><canvas id="weeklyProgressChart"></canvas></div>
  </div>
</div>

<%# ── Period comparison ── %>
<div class="grid-4 mb-8">
  <div class="stat-card" style="text-align:center">
    <div class="stat-card-label">This week</div>
    <div class="stat-card-value" id="thisWeekPL" style="font-size:22px">—</div>
  </div>
  <div class="stat-card" style="text-align:center">
    <div class="stat-card-label">Last week</div>
    <div class="stat-card-value" id="lastWeekPL" style="font-size:22px;color:var(--color-muted)">—</div>
  </div>
  <div class="stat-card" style="text-align:center">
    <div class="stat-card-label">This month</div>
    <div class="stat-card-value stat-card-value--green" id="thisMonthPL" style="font-size:22px">—</div>
  </div>
  <div class="stat-card" style="text-align:center">
    <div class="stat-card-label">Last month</div>
    <div class="stat-card-value" id="lastMonthPL" style="font-size:22px;color:var(--color-muted)">—</div>
  </div>
</div>

<%# ── Recent bets ── %>
<div class="card">
  <div class="card-head">
    <span class="card-title">Recent bets</span>
    <a href="/bets" class="btn btn--sm">View all</a>
  </div>

  <% if (recentBets.length === 0) { %>
    <div class="empty-state">
      <div class="empty-state-icon">📋</div>
      <div class="empty-state-title">No bets recorded yet</div>
      <p><a href="/bets/new">Add your first bet</a></p>
    </div>
  <% } else { %>
    <div class="ruled-table-wrap">
      <table class="ruled-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Event</th>
            <th class="hidden-sm">Type</th>
            <th class="hidden-md">Platform</th>
            <th class="text-right">Stake</th>
            <th class="text-center">Result</th>
            <th class="text-right">P&amp;L</th>
          </tr>
        </thead>
        <tbody>
          <% recentBets.forEach(bet => { %>
            <tr>
              <td class="td-num" style="white-space:nowrap;color:var(--color-muted);font-size:12px">
                <%= moment(bet.date).format('DD MMM YY') %>
              </td>
              <td>
                <div class="td-event">
                  <a href="/bets/<%= bet._id %>">
                    <%= bet.event.length > 32 ? bet.event.substring(0, 32) + '…' : bet.event %>
                  </a>
                </div>
              </td>
              <td class="hidden-sm"><span class="type-chip"><%= bet.betType %></span></td>
              <td class="hidden-md" style="font-size:12px;color:var(--color-muted)"><%= bet.platform %></td>
              <td class="text-right td-num">₹<%= bet.stake.toFixed(2) %></td>
              <td class="text-center">
                <span class="result-chip result-chip--<%= bet.result.toLowerCase().replace(/ /g, '') %>">
                  <%= bet.result %>
                </span>
              </td>
              <td class="text-right td-num <%= bet.profitLoss >= 0 ? 'td-num--green' : 'td-num--red' %>">
                <%= bet.profitLoss >= 0 ? '+' : '' %>₹<%= bet.profitLoss.toFixed(2) %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%# ── Chart scripts ── %>
<script>
  const INK   = getComputedStyle(document.documentElement).getPropertyValue('--color-muted').trim();
  const ACCENT = 'oklch(70% 0.19 40)';
  const GREEN  = 'oklch(48% 0.11 150)';
  const RED    = 'oklch(44% 0.18 22)';
  const GRID   = 'oklch(90% 0.014 85)';
  const PAPER  = 'oklch(96% 0.011 85)';

  const chartDefaults = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: {
        labels: { color: '#8a7f72', font: { size: 11, family: "'Red Hat Text', sans-serif" } }
      }
    }
  };

  const months    = <%- chartData.months %>;
  const monthlyPL = <%- chartData.monthlyPL %>;
  const cumulPL   = <%- chartData.cumulativePL %>;

  new Chart(document.getElementById('plLineChart'), {
    type: 'line',
    data: {
      labels: months,
      datasets: [
        {
          label: 'Monthly P&L (₹)',
          data: monthlyPL,
          borderColor: ACCENT,
          backgroundColor: 'oklch(70% 0.19 40 / 0.1)',
          fill: true, tension: 0.4,
          pointBackgroundColor: ACCENT, pointRadius: 4,
        },
        {
          label: 'Cumulative P&L (₹)',
          data: cumulPL,
          borderColor: '#8a7f72',
          backgroundColor: 'transparent',
          fill: false, tension: 0.4,
          borderDash: [4, 4],
          pointBackgroundColor: '#8a7f72', pointRadius: 3,
        },
      ],
    },
    options: {
      ...chartDefaults,
      scales: {
        x: { ticks: { color: '#8a7f72', font: { size: 11 } }, grid: { color: GRID } },
        y: { ticks: { color: '#8a7f72', callback: v => '₹' + v, font: { size: 11 } }, grid: { color: GRID } },
      },
    },
  });

  const betTypeLabels = <%- chartData.betTypeLabels %>;
  const betTypeCounts = <%- chartData.betTypeCounts %>;
  const pieColors = [ACCENT, GREEN, RED, '#8b7355', '#6b8e6b', '#9e7b56', '#5c8a8a', '#7a6e5a', '#a07050', '#6e8070'];

  new Chart(document.getElementById('betTypePieChart'), {
    type: 'doughnut',
    data: {
      labels: betTypeLabels,
      datasets: [{ data: betTypeCounts, backgroundColor: pieColors.slice(0, betTypeLabels.length), borderColor: PAPER, borderWidth: 2 }],
    },
    options: { ...chartDefaults, cutout: '62%' },
  });

  const resultLabels = <%- chartData.resultLabels %>;
  const resultCounts = <%- chartData.resultCounts %>;
  const resultColors = resultLabels.map(l =>
    l === 'Win' ? GREEN : l === 'Loss' ? RED : l === 'Pending' ? '#b08010' : '#8a7f72'
  );

  new Chart(document.getElementById('resultDonutChart'), {
    type: 'doughnut',
    data: {
      labels: resultLabels,
      datasets: [{ data: resultCounts, backgroundColor: resultColors, borderColor: PAPER, borderWidth: 2 }],
    },
    options: { ...chartDefaults, cutout: '62%' },
  });

  const platformLabels = <%- chartData.platformLabels %>;
  const platformCounts = <%- chartData.platformCounts %>;

  new Chart(document.getElementById('platformBarChart'), {
    type: 'bar',
    data: {
      labels: platformLabels,
      datasets: [{
        label: 'Number of bets',
        data: platformCounts,
        backgroundColor: 'oklch(70% 0.19 40 / 0.7)',
        borderColor: ACCENT,
        borderWidth: 1,
        borderRadius: 4,
      }],
    },
    options: {
      ...chartDefaults,
      scales: {
        x: { ticks: { color: '#8a7f72', font: { size: 11 } }, grid: { color: 'transparent' } },
        y: { ticks: { color: '#8a7f72', stepSize: 1, font: { size: 11 } }, grid: { color: GRID } },
      },
    },
  });

  const weeklyData = <%- typeof weeklyData !== 'undefined' ? weeklyData : '[]' %>;

  if (weeklyData.length > 0) {
    new Chart(document.getElementById('weeklyProgressChart'), {
      type: 'line',
      data: {
        labels: weeklyData.map(w => w.week),
        datasets: [
          {
            label: 'Weekly P&L (₹)',
            data: weeklyData.map(w => w.profitLoss),
            borderColor: ACCENT,
            backgroundColor: 'oklch(70% 0.19 40 / 0.08)',
            fill: true, tension: 0.4, yAxisID: 'y',
          },
          {
            label: 'Win rate (%)',
            data: weeklyData.map(w => parseFloat(w.winRate)),
            borderColor: GREEN,
            backgroundColor: 'transparent',
            fill: false, tension: 0.4, yAxisID: 'y1',
          },
        ],
      },
      options: {
        ...chartDefaults,
        scales: {
          x: { ticks: { color: '#8a7f72', font: { size: 11 } }, grid: { color: GRID } },
          y: { type: 'linear', position: 'left', ticks: { color: '#8a7f72', callback: v => '₹' + v, font: { size: 11 } }, grid: { color: GRID } },
          y1: { type: 'linear', position: 'right', ticks: { color: '#8a7f72', callback: v => v + '%', font: { size: 11 } }, grid: { display: false } },
        },
      },
    });

    const thisWkEl   = document.getElementById('thisWeekPL');
    const lastWkEl   = document.getElementById('lastWeekPL');
    const thisMoEl   = document.getElementById('thisMonthPL');
    const lastMoEl   = document.getElementById('lastMonthPL');

    const thisWk = weeklyData[weeklyData.length - 1].profitLoss;
    const lastWk = (weeklyData[weeklyData.length - 2]?.profitLoss || 0);
    const mData  = <%- chartData.monthlyPL %>;
    const thisMo = parseFloat(mData[mData.length - 1]) || 0;
    const lastMo = parseFloat(mData[mData.length - 2]) || 0;

    thisWkEl.textContent = (thisWk >= 0 ? '+' : '') + '₹' + thisWk.toFixed(0);
    thisWkEl.style.color = thisWk >= 0 ? 'var(--color-green)' : 'var(--color-red)';
    lastWkEl.textContent = (lastWk >= 0 ? '+' : '') + '₹' + lastWk.toFixed(0);
    thisMoEl.textContent = (thisMo >= 0 ? '+' : '') + '₹' + thisMo.toFixed(0);
    thisMoEl.style.color = thisMo >= 0 ? 'var(--color-green)' : 'var(--color-red)';
    lastMoEl.textContent = (lastMo >= 0 ? '+' : '') + '₹' + lastMo.toFixed(0);
  }
</script>

<style>
.hidden-sm { display: none; }
.hidden-md { display: none; }
@media (min-width: 640px)  { .hidden-sm { display: table-cell; } }
@media (min-width: 900px)  { .hidden-md { display: table-cell; } }
</style>
