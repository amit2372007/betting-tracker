<!-- Error View -->

<div class="flex items-center justify-center min-h-[60vh]">
  <div class="text-center">
    <div class="text-8xl mb-6">😵</div>
    <h1 class="text-4xl font-bold text-white mb-4">Oops!</h1>
    <p class="text-gray-400 mb-8 max-w-md mx-auto"><%= typeof message !== 'undefined' ? message : 'Something went wrong. Please try again.' %></p>
    <div class="flex gap-3 justify-center">
      <a href="/" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-xl font-medium transition-colors">
        🏠 Go Home
      </a>
      <button onclick="history.back()" class="bg-gray-800 hover:bg-gray-700 text-gray-300 px-6 py-3 rounded-xl font-medium transition-colors">
        ← Go Back
      </button>
    </div>
  </div>
</div>
