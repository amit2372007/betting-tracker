<%# Error Page — Furrow theme %>

<div class="empty-state" style="min-height:60vh;display:flex;align-items:center;justify-content:center">
  <div style="text-align:center;max-width:500px">
    <div class="empty-state-icon" style="font-size:80px;margin-bottom:var(--space-lg)">😵</div>
    <h1 style="font-family:var(--font-display);font-weight:600;font-size:32px;letter-spacing:var(--tracking-display);color:var(--color-ink);margin-bottom:var(--space-md)">
      Oops!
    </h1>
    <p style="color:var(--color-muted);font-size:15px;line-height:1.6;margin-bottom:var(--space-xl)">
      <%= typeof message !== 'undefined' ? message : 'Something went wrong. Please try again.' %>
    </p>
    <div style="display:flex;gap:var(--space-sm);justify-content:center;flex-wrap:wrap">
      <a href="/" class="btn btn--primary">Go home</a>
      <button onclick="history.back()" class="btn">Go back</button>
    </div>
  </div>
</div>
