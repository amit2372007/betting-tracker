<%# Add Transaction — Furrow theme %>

<a href="/finance/transactions" class="back-link">← All transactions</a>

<%# Error Messages %>
<% if (errors.length > 0) { %>
  <div class="error-list">
    <div class="error-list-title">Please fix the following errors:</div>
    <ul>
      <% errors.forEach(err => { %>
        <li><%= err.msg %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<%# Form card %>
<div class="card">
  <div class="card-head">
    <span class="card-title">Add transaction</span>
  </div>
  <div class="card-body">
    <form method="POST" action="/finance/transactions">

      <%# Transaction Type %>
      <div class="field mb-4">
        <label>Transaction type <span class="required">*</span></label>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:var(--space-sm)">
          <% [
            { value: 'income', icon: '💵', label: 'Income' },
            { value: 'expense', icon: '💸', label: 'Expense' },
            { value: 'liability', icon: '⚠️', label: 'Liability' },
          ].forEach(type => { %>
            <label class="result-option">
              <input type="radio" name="type" value="<%= type.value %>"
                <%= transaction.type === type.value ? 'checked' : '' %> required />
              <div class="result-option-card">
                <div class="result-option-icon" style="font-size:24px"><%= type.icon %></div>
                <div class="result-option-label"><%= type.label %></div>
              </div>
            </label>
          <% }) %>
        </div>
      </div>

      <%# Date & Amount %>
      <div class="grid-2 mb-4">
        <div class="field">
          <label for="f-date">Date <span class="required">*</span></label>
          <input id="f-date" type="date" name="date" class="input"
            value="<%= transaction.date ? new Date(transaction.date).toISOString().split('T')[0] : new Date().toISOString().split('T')[0] %>" required />
        </div>

        <div class="field">
          <label for="f-amount">Amount (₹) <span class="required">*</span></label>
          <input id="f-amount" type="number" name="amount" class="input input--num"
            value="<%= transaction.amount || '' %>" placeholder="e.g., 5000"
            step="0.01" min="0.01" required />
        </div>
      </div>

      <%# Category %>
      <div class="field mb-4">
        <label for="f-category">Category <span class="required">*</span></label>
        <select id="f-category" name="category" class="input" required>
          <option value="">Select category...</option>
          <% Object.keys(categories).forEach(type => { %>
            <optgroup label="<%= type.charAt(0).toUpperCase() + type.slice(1) %>">
              <% categories[type].forEach(cat => { %>
                <option value="<%= cat %>" <%= transaction.category === cat ? 'selected' : '' %>><%= cat %></option>
              <% }) %>
            </optgroup>
          <% }) %>
        </select>
      </div>

      <%# Description %>
      <div class="field mb-4">
        <label for="f-desc">Description</label>
        <textarea id="f-desc" name="description" class="input" rows="3"
          placeholder="Add details about this transaction..."><%= transaction.description || '' %></textarea>
      </div>

      <hr class="form-rule" />

      <%# Recurring Type & Tags %>
      <div class="grid-2 mb-4">
        <div class="field">
          <label for="f-recurring">Recurring type</label>
          <select id="f-recurring" name="recurringType" class="input">
            <option value="One-time" <%= !transaction.recurringType || transaction.recurringType === 'One-time' ? 'selected' : '' %>>One-time</option>
            <option value="Daily" <%= transaction.recurringType === 'Daily' ? 'selected' : '' %>>Daily</option>
            <option value="Weekly" <%= transaction.recurringType === 'Weekly' ? 'selected' : '' %>>Weekly</option>
            <option value="Monthly" <%= transaction.recurringType === 'Monthly' ? 'selected' : '' %>>Monthly</option>
            <option value="Yearly" <%= transaction.recurringType === 'Yearly' ? 'selected' : '' %>>Yearly</option>
          </select>
        </div>

        <div class="field">
          <label for="f-tags">Tags (comma-separated)</label>
          <input id="f-tags" type="text" name="tags" class="input"
            value="<%= Array.isArray(transaction.tags) ? transaction.tags.join(', ') : (transaction.tags || '') %>"
            placeholder="e.g., business, tax-deductible" />
        </div>
      </div>

      <%# Submit Buttons %>
      <div style="display:flex;gap:var(--space-sm);padding-top:var(--space-md);border-top:var(--rule-hair)">
        <button type="submit" class="btn btn--primary" style="flex:1">Save transaction</button>
        <a href="/finance/transactions" class="btn">Cancel</a>
      </div>
    </form>
  </div>
</div>
