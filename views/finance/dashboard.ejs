<%# Finance Dashboard — Furrow theme %>

<%# Net Worth Banner %>
<div class="net-worth-banner mb-6">
  <div style="flex:1">
    <div class="net-worth-label">Total net worth</div>
    <div class="net-worth-value">₹<%= netWorth.toFixed(2) %></div>
    <div class="net-worth-sub">Finance balance + Betting profits</div>
  </div>
  <div class="net-worth-meta">
    <div class="net-worth-meta-item">
      <div class="meta-label">Finance</div>
      <div class="meta-val <%= summary.netBalance >= 0 ? 'td-num--green' : 'td-num--red' %>">
        <%= summary.netBalance >= 0 ? '+' : '' %>₹<%= summary.netBalance.toFixed(0) %>
      </div>
    </div>
    <div class="net-worth-meta-item">
      <div class="meta-label">Betting</div>
      <div class="meta-val <%= bettingStats.totalProfitLoss >= 0 ? 'td-num--green' : 'td-num--red' %>">
        <%= bettingStats.totalProfitLoss >= 0 ? '+' : '' %>₹<%= bettingStats.totalProfitLoss.toFixed(0) %>
      </div>
    </div>
  </div>
</div>

<%# Summary Cards %>
<div class="grid-4 mb-6">
  <div class="stat-card">
    <div class="stat-card-label">Total income</div>
    <div class="stat-card-value stat-card-value--green" style="font-size:26px">
      <span class="td-num">₹<%= summary.totalIncome.toFixed(0) %></span>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-card-label">Total expenses</div>
    <div class="stat-card-value stat-card-value--red" style="font-size:26px">
      <span class="td-num">₹<%= summary.totalExpenses.toFixed(0) %></span>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-card-label">Total liabilities</div>
    <div class="stat-card-value" style="font-size:26px;color:var(--color-yellow)">
      <span class="td-num">₹<%= summary.totalLiabilities.toFixed(0) %></span>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-card-label">Net balance</div>
    <div class="stat-card-value <%= summary.netBalance >= 0 ? 'stat-card-value--green' : 'stat-card-value--red' %>" style="font-size:26px">
      <span class="td-num"><%= summary.netBalance >= 0 ? '+' : '' %>₹<%= summary.netBalance.toFixed(0) %></span>
    </div>
  </div>
</div>

<%# Charts Grid %>
<div class="grid-charts mb-6">

  <%# Monthly Cash Flow %>
  <div class="card col-span-2">
    <div class="card-head">
      <span class="card-title">Monthly cash flow — last 12 months</span>
    </div>
    <div class="card-body">
      <div class="chart-wrap h-64"><canvas id="cashFlowChart"></canvas></div>
    </div>
  </div>

  <%# Expense Breakdown %>
  <div class="card">
    <div class="card-head">
      <span class="card-title">Expense breakdown</span>
    </div>
    <div class="card-body">
      <div class="chart-wrap h-56"><canvas id="expenseChart"></canvas></div>
    </div>
  </div>

  <%# Income Breakdown %>
  <div class="card">
    <div class="card-head">
      <span class="card-title">Income sources</span>
    </div>
    <div class="card-body">
      <div class="chart-wrap h-56"><canvas id="incomeChart"></canvas></div>
    </div>
  </div>
</div>

<%# Recent Transactions %>
<div class="card mb-6">
  <div class="card-head">
    <span class="card-title">Recent transactions</span>
    <a href="/finance/transactions" class="btn btn--sm">View all</a>
  </div>

  <% if (recentTransactions.length === 0) { %>
    <div class="empty-state">
      <div class="empty-state-icon">💰</div>
      <div class="empty-state-title">No transactions yet</div>
      <p><a href="/finance/add">Add your first transaction</a></p>
    </div>
  <% } else { %>
    <div style="padding:var(--space-sm) 0">
      <% recentTransactions.forEach(txn => { %>
        <div class="txn-item">
          <div class="txn-icon txn-icon--<%= txn.type %>">
            <%= txn.type === 'income' ? '↓' : txn.type === 'expense' ? '↑' : '⚠' %>
          </div>
          <div class="txn-info">
            <div class="txn-category"><%= txn.category %></div>
            <div class="txn-date"><%= moment(txn.date).format('DD MMM YYYY') %> • <%= txn.description || 'No description' %></div>
          </div>
          <div class="txn-amount txn-amount--<%= txn.type %>">
            <%= txn.type === 'income' ? '+' : '-' %>₹<%= txn.amount.toFixed(2) %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%# Quick Actions %>
<div style="display:flex;gap:var(--space-sm);flex-wrap:wrap">
  <a href="/finance/add" class="btn btn--primary" style="flex:1;min-width:200px;justify-content:center">Add transaction</a>
  <a href="/finance/transactions" class="btn" style="flex:1;min-width:200px;justify-content:center">View all</a>
  <a href="/finance/export/csv" class="btn" style="min-width:140px;justify-content:center">Export CSV</a>
</div>

<%# Chart Scripts %>
<script>
  const INK = getComputedStyle(document.documentElement).getPropertyValue('--color-muted').trim();
  const GREEN = 'oklch(48% 0.11 150)';
  const RED = 'oklch(44% 0.18 22)';
  const ACCENT = 'oklch(70% 0.19 40)';
  const GRID = 'oklch(90% 0.014 85)';
  const PAPER = 'oklch(96% 0.011 85)';

  const cashFlowData = <%- cashFlow %>;
  const expenseBreakdown = <%- expenseBreakdown %>;
  const incomeBreakdown = <%- incomeBreakdown %>;

  // Cash Flow Chart
  new Chart(document.getElementById('cashFlowChart'), {
    type: 'bar',
    data: {
      labels: cashFlowData.map(d => d.month),
      datasets: [
        {
          label: 'Income (₹)',
          data: cashFlowData.map(d => d.income),
          backgroundColor: 'oklch(48% 0.11 150 / 0.7)',
          borderColor: GREEN,
          borderWidth: 1,
          borderRadius: 4,
        },
        {
          label: 'Expenses (₹)',
          data: cashFlowData.map(d => d.expense),
          backgroundColor: 'oklch(44% 0.18 22 / 0.7)',
          borderColor: RED,
          borderWidth: 1,
          borderRadius: 4,
        },
        {
          label: 'Net (₹)',
          data: cashFlowData.map(d => d.net),
          type: 'line',
          borderColor: ACCENT,
          backgroundColor: 'oklch(70% 0.19 40 / 0.1)',
          borderWidth: 2,
          tension: 0.4,
          fill: true,
        },
      ],
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { labels: { color: '#8a7f72', font: { size: 11, family: "'Red Hat Text', sans-serif" } } } },
      scales: {
        x: { ticks: { color: '#8a7f72', font: { size: 11 } }, grid: { color: 'transparent' } },
        y: { ticks: { color: '#8a7f72', callback: v => '₹' + v, font: { size: 11 } }, grid: { color: GRID } },
      },
    },
  });

  const pieColors = [ACCENT, GREEN, RED, '#8b7355', '#6b8e6b', '#9e7b56', '#5c8a8a', '#7a6e5a', '#a07050', '#6e8070'];

  // Expense Pie
  new Chart(document.getElementById('expenseChart'), {
    type: 'doughnut',
    data: {
      labels: expenseBreakdown.map(d => d.category),
      datasets: [{
        data: expenseBreakdown.map(d => d.total),
        backgroundColor: pieColors.slice(0, expenseBreakdown.length),
        borderColor: PAPER,
        borderWidth: 2,
      }],
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { labels: { color: '#8a7f72', font: { size: 10, family: "'Red Hat Text', sans-serif" } } } },
      cutout: '62%',
    },
  });

  // Income Pie
  new Chart(document.getElementById('incomeChart'), {
    type: 'doughnut',
    data: {
      labels: incomeBreakdown.map(d => d.category),
      datasets: [{
        data: incomeBreakdown.map(d => d.total),
        backgroundColor: pieColors.slice(0, incomeBreakdown.length),
        borderColor: PAPER,
        borderWidth: 2,
      }],
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { labels: { color: '#8a7f72', font: { size: 10, family: "'Red Hat Text', sans-serif" } } } },
      cutout: '62%',
    },
  });
</script>
