<%# All Transactions — Furrow theme %>

<%# Toolbar %>
<div class="toolbar mb-6">
  <div class="toolbar-left">
    <span class="section-title">All transactions</span>
    <span class="record-count"><%= totalTransactions %> records</span>
  </div>
  <div class="toolbar-right">
    <a href="/finance/export/csv" class="btn btn--sm">CSV</a>
    <a href="/finance/add" class="btn btn--primary btn--sm">+ Add transaction</a>
  </div>
</div>

<%# Filters %>
<div class="card mb-6">
  <div class="card-body">
    <form method="GET" action="/finance/transactions">
      <div class="filter-bar">
        <div class="field">
          <label for="f-search">Search</label>
          <input id="f-search" type="text" name="search" class="input" placeholder="Search..." value="<%= filters.search || '' %>" />
        </div>
        <div class="field">
          <label for="f-type">Type</label>
          <select id="f-type" name="type" class="input">
            <option value="all">All types</option>
            <option value="income" <%= filters.type === 'income' ? 'selected' : '' %>>Income</option>
            <option value="expense" <%= filters.type === 'expense' ? 'selected' : '' %>>Expense</option>
            <option value="liability" <%= filters.type === 'liability' ? 'selected' : '' %>>Liability</option>
          </select>
        </div>
        <div class="field">
          <label for="f-category">Category</label>
          <select id="f-category" name="category" class="input">
            <option value="all">All categories</option>
            <% Object.keys(categories).forEach(type => { %>
              <optgroup label="<%= type.charAt(0).toUpperCase() + type.slice(1) %>">
                <% categories[type].forEach(cat => { %>
                  <option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= cat %></option>
                <% }) %>
              </optgroup>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label for="f-start">From</label>
          <input id="f-start" type="date" name="startDate" class="input" value="<%= filters.startDate || '' %>" />
        </div>
        <div class="field">
          <label for="f-end">To</label>
          <input id="f-end" type="date" name="endDate" class="input" value="<%= filters.endDate || '' %>" />
        </div>
        <div class="field" style="flex-direction:row;align-items:flex-end;gap:8px">
          <button type="submit" class="btn btn--primary">Filter</button>
          <a href="/finance/transactions" class="btn">Clear</a>
        </div>
      </div>
    </form>
  </div>
</div>

<%# Mini Stats Bar %>
<div class="grid-4 mb-6">
  <div class="stat-card" style="text-align:center">
    <div class="stat-card-label">Income</div>
    <div class="stat-card-value stat-card-value--green" style="font-size:20px">
      <span class="td-num">₹<%= summary.totalIncome.toFixed(0) %></span>
    </div>
  </div>
  <div class="stat-card" style="text-align:center">
    <div class="stat-card-label">Expenses</div>
    <div class="stat-card-value stat-card-value--red" style="font-size:20px">
      <span class="td-num">₹<%= summary.totalExpenses.toFixed(0) %></span>
    </div>
  </div>
  <div class="stat-card" style="text-align:center">
    <div class="stat-card-label">Liabilities</div>
    <div class="stat-card-value" style="font-size:20px;color:var(--color-yellow)">
      <span class="td-num">₹<%= summary.totalLiabilities.toFixed(0) %></span>
    </div>
  </div>
  <div class="stat-card" style="text-align:center">
    <div class="stat-card-label">Net</div>
    <div class="stat-card-value <%= summary.netBalance >= 0 ? 'stat-card-value--green' : 'stat-card-value--red' %>" style="font-size:20px">
      <span class="td-num"><%= summary.netBalance >= 0 ? '+' : '' %>₹<%= summary.netBalance.toFixed(0) %></span>
    </div>
  </div>
</div>

<%# Transactions Table %>
<div class="card">
  <% if (transactions.length === 0) { %>
    <div class="empty-state">
      <div class="empty-state-icon">💰</div>
      <div class="empty-state-title">No transactions found</div>
      <p>Try adjusting your filters or <a href="/finance/add">add a transaction</a></p>
    </div>
  <% } else { %>
    <div class="ruled-table-wrap">
      <table class="ruled-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Category</th>
            <th class="hidden-sm">Description</th>
            <th class="text-right">Amount</th>
            <th class="hidden-md">Recurring</th>
            <th class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% transactions.forEach(txn => { %>
            <tr>
              <td class="td-num" style="white-space:nowrap;font-size:12px;color:var(--color-muted)">
                <%= moment(txn.date).format('DD MMM YY') %>
              </td>
              <td>
                <span class="result-chip result-chip--<%= txn.type === 'income' ? 'win' : txn.type === 'expense' ? 'loss' : 'pending' %>">
                  <%= txn.type %>
                </span>
              </td>
              <td>
                <div class="td-event"><%= txn.category %></div>
              </td>
              <td class="hidden-sm" style="max-width:200px">
                <div class="td-sub" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                  <%= txn.description || '-' %>
                </div>
              </td>
              <td class="text-right td-num <%= txn.type === 'income' ? 'td-num--green' : txn.type === 'expense' ? 'td-num--red' : '' %>" style="<%= txn.type === 'liability' ? 'color:var(--color-yellow)' : '' %>">
                <%= txn.type === 'income' ? '+' : '-' %>₹<%= txn.amount.toFixed(2) %>
              </td>
              <td class="hidden-md" style="font-size:12px;color:var(--color-muted)">
                <%= txn.recurringType %>
              </td>
              <td class="text-center">
                <div class="action-icons">
                  <form method="POST" action="/finance/transactions/<%= txn._id %>?_method=DELETE" style="display:inline" onsubmit="return confirm('Delete this transaction?')">
                    <button type="submit" class="action-btn action-btn--danger" title="Delete">
                      <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <%# Pagination %>
    <% if (totalPages > 1) { %>
      <div class="pagination">
        <p class="pagination-info">Page <%= currentPage %> of <%= totalPages %> — <%= totalTransactions %> transactions</p>
        <div class="pagination-links">
          <% if (currentPage > 1) { %>
            <a href="?page=<%= currentPage - 1 %>&type=<%= filters.type || 'all' %>&category=<%= filters.category || 'all' %>&startDate=<%= filters.startDate || '' %>&endDate=<%= filters.endDate || '' %>&search=<%= filters.search || '' %>"
               class="pagination-link">←</a>
          <% } %>
          <% for (let p = Math.max(1, currentPage - 2); p <= Math.min(totalPages, currentPage + 2); p++) { %>
            <a href="?page=<%= p %>&type=<%= filters.type || 'all' %>&category=<%= filters.category || 'all' %>&startDate=<%= filters.startDate || '' %>&endDate=<%= filters.endDate || '' %>&search=<%= filters.search || '' %>"
               class="pagination-link <%= p === currentPage ? 'pagination-link--active' : '' %>"><%= p %></a>
          <% } %>
          <% if (currentPage < totalPages) { %>
            <a href="?page=<%= currentPage + 1 %>&type=<%= filters.type || 'all' %>&category=<%= filters.category || 'all' %>&startDate=<%= filters.startDate || '' %>&endDate=<%= filters.endDate || '' %>&search=<%= filters.search || '' %>"
               class="pagination-link">→</a>
          <% } %>
        </div>
      </div>
    <% } %>
  <% } %>
</div>

<style>
.hidden-sm { display: none; }
.hidden-md { display: none; }
@media (min-width: 640px)  { .hidden-sm { display: table-cell; } }
@media (min-width: 900px)  { .hidden-md { display: table-cell; } }
</style>
