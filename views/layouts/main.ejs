<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' | BetTracker' : 'BetTracker' %></title>

  <!-- Furrow: Red Hat font stack -->
  <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@600&family=Red+Hat+Text:wght@400;500&family=Red+Hat+Mono:wght@400;500&display=swap" rel="stylesheet">

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

  <!-- Custom CSS (Furrow tokens + components) -->
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>

  <!-- Sidebar Overlay (mobile) -->
  <div class="sidebar-overlay" id="overlay"></div>

  <!-- Sidebar -->
  <aside id="sidebar" class="sidebar">

    <!-- Logo / Wordmark -->
    <div class="sidebar-wordmark">
      <div class="wordmark-symbol">S</div>
      <div>
        <div class="wordmark-name">StakeLab</div>
        <div class="wordmark-sub">Field Records</div>
      </div>
    </div>

    <!-- Navigation -->
    <nav class="sidebar-nav">

      <a href="/" class="sidebar-link <%= currentPath === '/' ? 'sidebar-link--active' : '' %>">
        <svg class="sidebar-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zm0 6a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1v-2zm0 6a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1v-2z"/></svg>
        Dashboard
      </a>

      <a href="/bets" class="sidebar-link <%= currentPath.startsWith('/bets') && currentPath !== '/bets/new' ? 'sidebar-link--active' : '' %>">
        <svg class="sidebar-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm3 1h6v4H7V5zm8 8v2h1v1H4v-1h1v-2a1 1 0 011-1h8a1 1 0 011 1z" clip-rule="evenodd"/></svg>
        All Bets
      </a>

      <a href="/bets/new" class="sidebar-link <%= currentPath === '/bets/new' ? 'sidebar-link--active' : '' %>">
        <svg class="sidebar-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/></svg>
        Add Bet
      </a>

      <div class="sidebar-divider">
        <span class="sidebar-section-label">Management</span>
      </div>

      <a href="/strategy" class="sidebar-link <%= currentPath.startsWith('/strategy') ? 'sidebar-link--active' : '' %>">
        <svg class="sidebar-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zm6-4a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zm6-3a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"/></svg>
        Strategy
      </a>

      <a href="/finance" class="sidebar-link <%= currentPath.startsWith('/finance') ? 'sidebar-link--active' : '' %>">
        <svg class="sidebar-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z"/><path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z" clip-rule="evenodd"/></svg>
        Finance
      </a>

      <div class="sidebar-divider">
        <span class="sidebar-section-label">Export</span>
      </div>

      <a href="/bets/export/csv" class="sidebar-link">
        <svg class="sidebar-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
        Export CSV
      </a>

      <a href="/bets/export/pdf" class="sidebar-link">
        <svg class="sidebar-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/></svg>
        Export PDF
      </a>
    </nav>

    <div class="sidebar-footer">
      StakeLab v2.0
    </div>
  </aside>

  <!-- Main Content -->
  <div class="main-wrap">

    <!-- Top Navbar -->
    <header class="topbar">
      <div class="topbar-inner">
        <!-- Mobile menu button -->
        <button onclick="toggleSidebar()" class="topbar-menu-btn" aria-label="Toggle menu">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" d="M3 5h14M3 10h14M3 15h14"/>
          </svg>
        </button>

        <div class="topbar-title">
          <%= typeof title !== 'undefined' ? title : 'Dashboard' %>
        </div>

        <a href="/bets/new" class="btn btn--primary topbar-cta">
          <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/></svg>
          <span>Add Bet</span>
        </a>
      </div>
    </header>

    <!-- Flash Messages -->
    <% if (success_msg && success_msg.length > 0) { %>
      <div class="flash flash--success" id="flash-success">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
        <span><%= success_msg %></span>
        <button onclick="this.parentElement.remove()" class="flash-close" aria-label="Dismiss">✕</button>
      </div>
    <% } %>
    <% if (error_msg && error_msg.length > 0) { %>
      <div class="flash flash--error" id="flash-error">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
        <span><%= error_msg %></span>
        <button onclick="this.parentElement.remove()" class="flash-close" aria-label="Dismiss">✕</button>
      </div>
    <% } %>

    <!-- Page Content -->
    <main class="page-content">
      <%- body %>
    </main>

    <!-- Footer -->
    <footer class="page-footer">
      &copy; <%= new Date().getFullYear() %> Stake Lab - Sophisticated, suggests data-driven analysis    </footer>
  </div>

  <!-- Scripts -->
  <script src="/js/main.js"></script>

  <script>
    function toggleSidebar() {
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('overlay');
      sidebar.classList.toggle('sidebar--open');
      overlay.classList.toggle('overlay--visible');
    }

    // Auto-dismiss flash messages after 4 seconds
    setTimeout(() => {
      const flashSuccess = document.getElementById('flash-success');
      const flashError = document.getElementById('flash-error');
      if (flashSuccess) flashSuccess.style.opacity = '0';
      if (flashError) flashError.style.opacity = '0';
      setTimeout(() => {
        if (flashSuccess) flashSuccess.remove();
        if (flashError) flashError.remove();
      }, 300);
    }, 4000);
  </script>
</body>
</html>
