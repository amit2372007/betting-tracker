<!DOCTYPE html>
<html lang="en" class="scroll-smooth" id="html-root">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' | BetTracker Pro' : 'BetTracker Pro' %></title>

  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            primary: {
              50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe',
              300: '#93c5fd', 400: '#60a5fa', 500: '#3b82f6',
              600: '#2563eb', 700: '#1d4ed8', 800: '#1e40af', 900: '#1e3a8a',
            },
            profit: '#16a34a',
            loss: '#dc2626',
          },
          animation: {
            'fade-in': 'fadeIn 0.3s ease-in-out',
            'slide-up': 'slideUp 0.4s ease-out',
          },
          keyframes: {
            fadeIn: { '0%': { opacity: '0' }, '100%': { opacity: '1' } },
            slideUp: { '0%': { transform: 'translateY(20px)', opacity: '0' }, '100%': { transform: 'translateY(0)', opacity: '1' } },
          },
        },
      },
    };
  </script>

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body class="bg-gray-950 text-gray-100 min-h-screen font-sans transition-colors duration-300">

  <!-- Sidebar Overlay (mobile) -->
  <div class="sidebar-overlay fixed inset-0 bg-black/60 z-20 hidden lg:hidden" id="overlay" onclick="toggleSidebar()"></div>

  <!-- Sidebar -->
  <aside id="sidebar" class="fixed top-0 left-0 h-full w-64 bg-gray-900 border-r border-gray-800 z-30 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 flex flex-col">

    <!-- Logo -->
    <div class="p-6 border-b border-gray-800">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl flex items-center justify-center">
          <span class="text-xl">🎲</span>
        </div>
        <div>
          <h1 class="font-bold text-lg text-white">BetTracker</h1>
          <p class="text-xs text-gray-400">Pro Analytics</p>
        </div>
      </div>
    </div>

    <!-- Navigation -->
    <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
      <!-- Main Menu -->
      <a href="/"
        class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200 <%= currentPath === '/' ? 'bg-blue-600 text-white shadow-lg shadow-blue-600/30' : 'text-gray-400 hover:bg-gray-800 hover:text-white' %>">
        <span class="text-lg">📊</span>
        <span class="truncate">Dashboard</span>
      </a>

      <a href="/bets"
        class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200 <%= currentPath.startsWith('/bets') && currentPath !== '/bets/new' ? 'bg-blue-600 text-white shadow-lg shadow-blue-600/30' : 'text-gray-400 hover:bg-gray-800 hover:text-white' %>">
        <span class="text-lg">📋</span>
        <span class="truncate">All Bets</span>
      </a>

      <a href="/bets/new"
        class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200 <%= currentPath === '/bets/new' ? 'bg-blue-600 text-white shadow-lg shadow-blue-600/30' : 'text-gray-400 hover:bg-gray-800 hover:text-white' %>">
        <span class="text-lg">➕</span>
        <span class="truncate">Add New Bet</span>
      </a>

      <!-- NEW: Strategy Section -->
      <div class="pt-4 border-t border-gray-800 mt-4">
        <p class="text-xs text-gray-500 uppercase tracking-wider px-4 mb-2">Management</p>
        <a href="/strategy"
          class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200 <%= currentPath.startsWith('/strategy') ? 'bg-blue-600 text-white shadow-lg shadow-blue-600/30' : 'text-gray-400 hover:bg-gray-800 hover:text-white' %>">
          <span class="text-lg">💰</span>
          <span class="truncate">Strategy</span>
        </a>
        <a href="/finance"
          class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200 <%= currentPath.startsWith('/finance') ? 'bg-blue-600 text-white shadow-lg shadow-blue-600/30' : 'text-gray-400 hover:bg-gray-800 hover:text-white' %>">
          <span class="text-lg">💳</span>
          <span class="truncate">Finance</span>
        </a>
      </div>

      <!-- Export -->
      <div class="pt-4 border-t border-gray-800 mt-4">
        <p class="text-xs text-gray-500 uppercase tracking-wider px-4 mb-2">Export</p>
        <a href="/bets/export/csv"
          class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-gray-400 hover:bg-gray-800 hover:text-white transition-all duration-200">
          <span class="text-lg">📄</span>
          <span class="truncate">Export CSV</span>
        </a>
        <a href="/bets/export/pdf"
          class="sidebar-link flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-gray-400 hover:bg-gray-800 hover:text-white transition-all duration-200">
          <span class="text-lg">📑</span>
          <span class="truncate">Export PDF</span>
        </a>
      </div>
    </nav>

    <!-- Footer -->
    <div class="p-4 border-t border-gray-800">
      <p class="text-xs text-gray-500 text-center">BetTracker Pro v1.0</p>
    </div>
  </aside>

  <!-- Main Content -->
  <div class="lg:ml-64 min-h-screen flex flex-col">

    <!-- Top Navbar -->
    <header class="sticky top-0 z-10 bg-gray-950/95 backdrop-blur border-b border-gray-800 px-6 py-4">
      <div class="flex items-center justify-between">
        <!-- Mobile menu button -->
        <button onclick="toggleSidebar()" class="lg:hidden text-gray-400 hover:text-white transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <div class="hidden lg:block">
          <h2 class="text-xl font-semibold text-white"><%= typeof title !== 'undefined' ? title : 'Dashboard' %></h2>
        </div>

        <div class="flex items-center gap-3 ml-auto">
          <!-- Add Bet Quick Button -->
          <a href="/bets/new"
            class="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 shadow-lg shadow-blue-600/30 hover:shadow-blue-600/50">
            <span>+</span>
            <span class="hidden sm:inline">Add Bet</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Flash Messages -->
    <% if (success_msg && success_msg.length > 0) { %>
      <div class="mx-6 mt-4 bg-green-900/50 border border-green-700 text-green-300 px-4 py-3 rounded-xl flex items-center gap-2 animate-fade-in" id="flash-success">
        <span class="text-lg">✅</span>
        <span><%= success_msg %></span>
        <button onclick="this.parentElement.remove()" class="ml-auto text-green-400 hover:text-green-200">✕</button>
      </div>
    <% } %>
    <% if (error_msg && error_msg.length > 0) { %>
      <div class="mx-6 mt-4 bg-red-900/50 border border-red-700 text-red-300 px-4 py-3 rounded-xl flex items-center gap-2 animate-fade-in" id="flash-error">
        <span class="text-lg">❌</span>
        <span><%= error_msg %></span>
        <button onclick="this.parentElement.remove()" class="ml-auto text-red-400 hover:text-red-200">✕</button>
      </div>
    <% } %>

    <!-- Page Content -->
    <main class="flex-1 p-6 animate-slide-up">
      <%- body %>
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-800 px-6 py-4 text-center text-xs text-gray-500">
      &copy; <%= new Date().getFullYear() %> BetTracker Pro — Track Smart, Bet Smarter
    </footer>
  </div>

  <!-- Scripts -->
  <script src="/js/main.js"></script>

  <script>
    function toggleSidebar() {
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('overlay');
      sidebar.classList.toggle('-translate-x-full');
      overlay.classList.toggle('hidden');
    }

    // Auto-dismiss flash messages after 4 seconds
    setTimeout(() => {
      const flashSuccess = document.getElementById('flash-success');
      const flashError = document.getElementById('flash-error');
      if (flashSuccess) flashSuccess.remove();
      if (flashError) flashError.remove();
    }, 4000);
  </script>
</body>
</html>
