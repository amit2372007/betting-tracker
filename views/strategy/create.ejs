<%# Create Strategy — Furrow theme %>

<a href="/strategy" class="back-link">← Strategy dashboard</a>

<div class="card" style="max-width:800px;margin:0 auto">
  <div class="card-head">
    <span class="card-title">Create your 90-day strategy</span>
  </div>
  <div class="card-body">
    <div style="text-align:center;margin-bottom:var(--space-xl);padding:var(--space-lg);background:var(--color-paper-3);border-radius:var(--radius-card)">
      <div style="font-size:40px;margin-bottom:var(--space-sm)">💰</div>
      <p style="color:var(--color-muted);font-size:14px">Set up bankroll management with stop-loss & profit targets</p>
    </div>

    <% if (errors.length > 0) { %>
      <div class="error-list">
        <div class="error-list-title">Please fix the following errors:</div>
        <ul>
          <% errors.forEach(err => { %>
            <li><%= err.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form method="POST" action="/strategy/create">

      <%# Initial Bankroll %>
      <div class="field mb-4">
        <label for="f-bankroll">Initial bankroll (₹) <span class="required">*</span></label>
        <input id="f-bankroll" type="number" name="initialBankroll" class="input input--num"
          value="<%= strategy.initialBankroll || '' %>" placeholder="e.g., 10000"
          step="100" min="100" required />
        <div style="font-size:11.5px;color:var(--color-muted);margin-top:4px">Minimum ₹100 required to start</div>
      </div>

      <%# Daily Target Percentage %>
      <div class="field mb-4">
        <label for="f-daily">Daily target percentage (1-8%) <span class="required">*</span></label>
        <input id="f-daily" type="number" name="dailyTargetPercentage" class="input input--num"
          value="<%= strategy.dailyTargetPercentage || 3 %>" placeholder="e.g., 3"
          step="0.5" min="1" max="8" required />
        <div style="font-size:11.5px;color:var(--color-muted);margin-top:4px">Target daily return as % of bankroll (3% is typical)</div>
      </div>

      <%# Risk Level %>
      <div class="field mb-4">
        <label>Risk level <span class="required">*</span></label>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:var(--space-sm)">
          <% [
            { value: 'Conservative', icon: '🛡️', desc: '2% per bet' },
            { value: 'Moderate', icon: '⚖️', desc: '5% per bet' },
            { value: 'Aggressive', icon: '🚀', desc: '10% per bet' },
          ].forEach(risk => { %>
            <label class="result-option">
              <input type="radio" name="riskLevel" value="<%= risk.value %>"
                <%= !strategy.riskLevel && risk.value === 'Moderate' ? 'checked' : '' %>
                <%= strategy.riskLevel === risk.value ? 'checked' : '' %> required />
              <div class="result-option-card" style="min-height:80px">
                <div class="result-option-icon" style="font-size:22px"><%= risk.icon %></div>
                <div class="result-option-label" style="font-weight:600;margin-bottom:2px"><%= risk.value %></div>
                <div style="font-size:11px;color:var(--color-muted)"><%= risk.desc %></div>
              </div>
            </label>
          <% }) %>
        </div>
      </div>

      <hr class="form-rule" />

      <%# Stop-Loss & Stop-Profit %>
      <div class="grid-2 mb-4">
        <div class="field">
          <label for="f-stoploss">Stop-loss % <span class="required">*</span></label>
          <input id="f-stoploss" type="number" name="stopLossPercentage" class="input input--num"
            value="<%= strategy.stopLossPercentage || 5 %>" placeholder="e.g., 5"
            step="0.5" min="1" max="20" required />
          <div style="font-size:11.5px;color:var(--color-muted);margin-top:4px">Max daily loss before stopping</div>
        </div>
        <div class="field">
          <label for="f-stopprofit">Stop-profit % <span class="required">*</span></label>
          <input id="f-stopprofit" type="number" name="stopProfitPercentage" class="input input--num"
            value="<%= strategy.stopProfitPercentage || 3 %>" placeholder="e.g., 3"
            step="0.5" min="1" max="15" required />
          <div style="font-size:11.5px;color:var(--color-muted);margin-top:4px">Daily profit target to lock gains</div>
        </div>
      </div>

      <%# Submit Button %>
      <div style="padding-top:var(--space-md);border-top:var(--rule-hair)">
        <button type="submit" class="btn btn--primary" style="width:100%;justify-content:center">
          Start 90-day strategy
        </button>
      </div>
    </form>
  </div>
</div>
