<!-- Current Bankroll Hero Section -->
<div class="bg-gradient-to-br from-blue-900/50 to-purple-900/30 border border-blue-800/50 rounded-3xl p-8 mb-8">
  <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
    <div class="flex-1">
      <p class="text-sm text-gray-400 mb-2">💰 Current Bankroll</p>
      <h1 class="text-5xl md:text-6xl font-bold text-white mb-3">₹<%= strategy.currentBankroll.toFixed(2) %></h1>
      <div class="flex flex-wrap gap-4 text-sm">
        <span class="<%= strategy.currentROI >= 0 ? 'text-green-400' : 'text-red-400' %>">
          ROI: <%= strategy.currentROI >= 0 ? '+' : '' %><%= strategy.currentROI.toFixed(1) %>%
        </span>
        <span class="text-gray-400">Started: <%= moment(strategy.strategyStartDate).format('DD MMM YYYY') %></span>
        <span class="text-gray-400">Day <%= strategy.daysElapsed %> of 90</span>
      </div>
    </div>
    <div class="text-center bg-gray-800/50 rounded-2xl p-6 min-w-[200px]">
      <p class="text-xs text-gray-400 mb-1">90-Day Target</p>
      <p class="text-3xl font-bold text-blue-400">₹<%= strategy.ninetyDayTargetAmount.toFixed(0) %></p>
      <p class="text-xs text-gray-500 mt-2"><%= strategy.daysRemaining %> days left</p>
    </div>
  </div>
</div>

<!-- Stop-Loss / Stop-Profit Alerts -->
<% if (stopLossCheck.triggered || stopProfitCheck.triggered) { %>
  <div class="mb-6">
    <% if (stopLossCheck.triggered) { %>
      <div class="bg-red-900/30 border-2 border-red-700 rounded-xl p-5 flex items-center gap-4 animate-pulse">
        <span class="text-4xl">🛑</span>
        <div>
          <p class="text-red-400 font-bold text-lg"><%= stopLossCheck.message %></p>
          <p class="text-gray-400 text-sm mt-1">Loss: ₹<%= stopLossCheck.currentLoss.toFixed(2) %> / Limit: ₹<%= stopLossCheck.threshold.toFixed(2) %></p>
        </div>
      </div>
    <% } %>
    <% if (stopProfitCheck.triggered) { %>
      <div class="bg-green-900/30 border-2 border-green-700 rounded-xl p-5 flex items-center gap-4">
        <span class="text-4xl">🎯</span>
        <div>
          <p class="text-green-400 font-bold text-lg"><%= stopProfitCheck.message %></p>
          <p class="text-gray-400 text-sm mt-1">Profit: ₹<%= stopProfitCheck.currentProfit.toFixed(2) %> / Target: ₹<%= stopProfitCheck.threshold.toFixed(2) %></p>
        </div>
      </div>
    <% } %>
  </div>
<% } %>

<!-- Today's Performance & Recommendations -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
  
  <!-- Today's Stats -->
  <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6">
    <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
      <span>📊</span> Today's Performance
    </h3>
    <div class="space-y-4">
      <div class="flex justify-between items-center">
        <span class="text-gray-400">Today's P&L</span>
        <span class="text-xl font-bold <%= todayPL >= 0 ? 'text-green-400' : 'text-red-400' %>">
          <%= todayPL >= 0 ? '+' : '' %>₹<%= todayPL.toFixed(2) %>
        </span>
      </div>
      <div class="flex justify-between items-center">
        <span class="text-gray-400">Daily Target</span>
        <span class="text-white">₹<%= (strategy.currentBankroll * (strategy.dailyTargetPercentage / 100)).toFixed(2) %></span>
      </div>
      <div class="w-full bg-gray-800 rounded-full h-3">
        <div class="<%= todayPL >= 0 ? 'bg-green-500' : 'bg-red-500' %> h-3 rounded-full transition-all" 
          style="width: <%= Math.min(Math.abs((todayPL / (strategy.currentBankroll * (strategy.dailyTargetPercentage / 100))) * 100), 100) %>%"></div>
      </div>
      <div class="grid grid-cols-2 gap-4 pt-4 border-t border-gray-800">
        <div>
          <p class="text-xs text-gray-500">Stop-Loss Limit</p>
          <p class="text-sm font-semibold text-red-400">₹<%= (strategy.currentBankroll * (strategy.stopLossPercentage / 100)).toFixed(2) %></p>
        </div>
        <div>
          <p class="text-xs text-gray-500">Stop-Profit Target</p>
          <p class="text-sm font-semibold text-green-400">₹<%= (strategy.currentBankroll * (strategy.stopProfitPercentage / 100)).toFixed(2) %></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Stake Recommendation -->
  <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6">
    <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
      <span>🎯</span> Recommended Stake
    </h3>
    
    <% if (recommendation.shouldStop) { %>
      <div class="text-center py-8">
        <p class="text-3xl mb-4">⛔</p>
        <p class="text-red-400 font-bold text-lg"><%= recommendation.message %></p>
        <div class="mt-4 text-left space-y-2">
          <% recommendation.reasoning.forEach(reason => { %>
            <p class="text-sm text-gray-400"><%= reason %></p>
          <% }) %>
        </div>
      </div>
    <% } else { %>
      <div class="text-center mb-6">
        <p class="text-5xl font-bold text-blue-400 mb-2">₹<%= recommendation.recommended %></p>
        <p class="text-sm text-gray-400"><%= recommendation.message %></p>
        <div class="flex justify-center gap-4 mt-4 text-xs">
          <span class="text-gray-500">Min: ₹<%= recommendation.min %></span>
          <span class="text-gray-500">Max: ₹<%= recommendation.max %></span>
        </div>
      </div>
      <div class="space-y-2 bg-gray-800/50 rounded-xl p-4">
        <p class="text-xs text-gray-500 uppercase font-semibold mb-2">Analysis</p>
        <% recommendation.reasoning.forEach(reason => { %>
          <p class="text-sm text-gray-300"><%= reason %></p>
        <% }) %>
      </div>
      <div class="mt-4 text-xs text-gray-500">
        <p>Kelly %: <%= recommendation.kellyInfo.recommendedKelly.toFixed(2) %>% of bankroll</p>
        <p>Max Daily Stake: ₹<%= strategy.dailyMaxStake.toFixed(2) %> (<%= strategy.riskLevel %>)</p>
      </div>
    <% } %>
  </div>
</div>

<!-- Progress Tracking -->
<div class="bg-gray-900 border border-gray-800 rounded-2xl p-6 mb-8">
  <h3 class="text-lg font-semibold text-white mb-4">📈 90-Day Progress</h3>
  <div class="h-64">
    <canvas id="progressChart"></canvas>
  </div>
</div>

<!-- Quick Actions -->
<div class="flex flex-wrap gap-3">
  <a href="/bets/new" class="flex-1 min-w-[200px] bg-blue-600 hover:bg-blue-700 text-white text-center py-4 rounded-xl font-semibold transition-colors">
    ➕ Place New Bet
  </a>
  <a href="/bets" class="flex-1 min-w-[200px] bg-gray-800 hover:bg-gray-700 text-white text-center py-4 rounded-xl font-semibold transition-colors">
    📋 View All Bets
  </a>
</div>

<!-- Chart Script -->
<script>
  const projections = <%- projections %>;
  const recentBets = <%- recentBets %>;

  // Build actual performance data
  const actualData = [];
  let cumulativePL = <%= strategy.initialBankroll %>;
  recentBets.forEach(bet => {
    cumulativePL += bet.dailyPL;
    actualData.push(cumulativePL);
  });

  new Chart(document.getElementById('progressChart'), {
    type: 'line',
    data: {
      labels: projections.map(p => `Day ${p.day}`),
      datasets: [
        {
          label: 'Target Projection',
          data: projections.map(p => p.amount),
          borderColor: '#3b82f6',
          backgroundColor: 'rgba(59,130,246,0.1)',
          borderDash: [5, 5],
          tension: 0.4,
          pointRadius: 0,
        },
        {
          label: 'Actual Performance',
          data: actualData,
          borderColor: '<%= strategy.currentBankroll >= strategy.initialBankroll ? "#16a34a" : "#dc2626" %>',
          backgroundColor: '<%= strategy.currentBankroll >= strategy.initialBankroll ? "rgba(22,163,74,0.1)" : "rgba(220,38,38,0.1)" %>',
          tension: 0.4,
          pointRadius: 3,
          pointBackgroundColor: '<%= strategy.currentBankroll >= strategy.initialBankroll ? "#16a34a" : "#dc2626" %>',
        },
      ],
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { labels: { color: '#9ca3af', font: { size: 11 } } },
      },
      scales: {
        x: { ticks: { color: '#6b7280' }, grid: { color: '#1f2937' } },
        y: {
          ticks: { color: '#6b7280', callback: (v) => '₹' + v.toFixed(0) },
          grid: { color: '#1f2937' },
        },
      },
    },
  });
</script>